# ===================================================================
# FoodRescue System - Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ===================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_APPLICATION_NAME=foodrescue-system

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================

# --- OPTION A: In-Memory H2 Database (Default for instant run) ---
DB_URL=jdbc:h2:mem:foodrescue_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
DB_DIALECT=org.hibernate.dialect.H2Dialect
H2_CONSOLE_ENABLED=true

# --- OPTION B: MySQL Database (Uncomment to use MySQL) ---
# DB_URL=jdbc:mysql://localhost:3306/foodrescue_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
# DB_DIALECT=org.hibernate.dialect.MySQLDialect
# H2_CONSOLE_ENABLED=false

# ===================================================================
# JPA & HIBERNATE CONFIGURATION
# ===================================================================
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ===================================================================
# SECURITY & JWT CONFIGURATION
# ===================================================================
JWT_SECRET=FoodRescueSuperSecretKeyForJWTTokenGeneration2026SecureKey!
JWT_EXPIRATION_MS=86400000

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================
LOGGING_LEVEL_WEB=INFO
LOGGING_LEVEL_APP=DEBUG
